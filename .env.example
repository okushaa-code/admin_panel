# Supabase төслийн хаяг (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co
# Зөвхөн сервер талд ашиглах нууц (service-role / sb_secret_...) түлхүүр.
# Браузерт, git-д, дэлгэцийн зурагт хэзээ ч бүү гарга.
SUPABASE_SECRET_KEY=
# Session-ийг гарын үсэглэх санамсаргүй урт мөр:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# HTTPS дээр байршуулахад 1 болгоно (локал http-д 0).
SESSION_COOKIE_SECURE=1

